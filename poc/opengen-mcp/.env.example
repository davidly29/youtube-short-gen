# Where media, renders and the SQLite library live (default ~/.opengen)
# OPENGEN_HOME=~/.opengen

# Default providers. Free ones need no key.
OPENGEN_TTS=edge              # edge (free) | elevenlabs | openai | offline
OPENGEN_IMAGE=pollinations    # pollinations (free) | fal | openai | card (offline)
OPENGEN_VIDEO=kenburns        # kenburns (free, local) | fal
OPENGEN_WHISPER_MODEL=base    # tiny | base | small | medium | large-v3
OPENGEN_FONT=Arial            # caption font; any installed font name

# Optional paid providers - billed to YOUR account at the provider's rates
# ELEVENLABS_API_KEY=
# FAL_KEY=
# OPENAI_API_KEY=
# OPENGEN_FAL_IMAGE_MODEL=fal-ai/flux/schnell
# OPENGEN_FAL_T2V_MODEL=fal-ai/kling-video/v2.1/standard/text-to-video
# OPENGEN_FAL_I2V_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video

# HTTP mode only: base URL used to build clickable /files/ links
# OPENGEN_PUBLIC_BASE_URL=http://127.0.0.1:8765
