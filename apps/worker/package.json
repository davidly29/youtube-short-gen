{
  "name": "@shortloop/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BullMQ workers, one file per pipeline stage",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "export:features": "tsx src/analytics/export-features.ts"
  },
  "dependencies": {
    "@shortloop/contracts": "workspace:*",
    "@shortloop/db": "workspace:*",
    "@shortloop/pipeline": "workspace:*",
    "@shortloop/providers": "workspace:*",
    "@shortloop/render": "workspace:*"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "tsx": "^4.23.15"
  }
}
